#-------------- DESKTOP MODIFICATIONS --------------#

[org.gtk.gtk4.Settings.FileChooser]
sort-directories-first=true

[org.gtk.Settings.FileChooser]
sort-directories-first=true

[org.gnome.desktop.input-sources]
sources=[('xkb', 'rs+latinyz')]
mru-sources=[('xkb', 'rs+latinyz')]
xkb-options=['caps:ctrl_modifier']

[org.gnome.desktop.interface]
show-battery-percentage=true
clock-show-weekday=true
document-font-name='Nokia Pure Text 11'
font-hinting='none'
font-rendering='manual'
font-name='Nokia Pure Text 11'
gtk-theme='adw-gtk3'
icon-theme='MoreWaita'
monospace-font-name='Source Code Pro 10'

[org.gnome.desktop.peripherals.keyboard]
delay=uint32 226
numlock-state=true

[org.gnome.desktop.peripherals.mouse]
accel-profile='flat'

[org.gnome.desktop.privacy]
remove-old-trash-files=true

[org.gnome.desktop.wm.preferences]
titlebar-font='Nokia Pure Text Bold 11'

[org.gnome.settings-daemon.plugins.power]
power-button-action='interactive'

[org.gnome.shell]
enabled-extensions=['simple-weather@romanlefler.com', 'caffeine@patapon.info', 'blur-my-shell@aunetx', 'middleclickclose@paolo.tranquilli.gmail.com', 'notifications-alert-on-user-menu@hackedbellini.gmail.com', 'Bluetooth-Battery-Meter@maniacx.github.com', 'nightthemeswitcher@romainvigier.fr', 'reboottouefi@ubaygd.com', 'gnome-ui-tune@itstime.tech', 'media-progress@krypion17', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['trivalent.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop']
always-show-log-out=true

[org.gnome.shell.extensions.blur-my-shell]
# Blur my Shell v76 replaced the native gaussian blur effects with a single kawase blur
# and dropped the per-component `sigma`/`brightness`/`customize` keys (blur strength is
# now configured exclusively through pipelines).
# pipeline_default = unscaled_radius 8, used by panel & dash-to-dock (they used the
#                    pipeline radius 8 in v75, as static blur is enabled there by default)
# pipeline_default_16 = unscaled_radius 16, matching the old sigma 8 on all the other
#                    components (upstream converts sigma to unscaled_radius as 2 * sigma)
pipelines={'pipeline_default': {'name': <'Default'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000000'>, 'params': <{'unscaled_radius': <8>, 'brightness': <0.6>}>}>]>}, 'pipeline_default_16': {'name': <'Default (16)'>, 'effects': <[<{'type': <'dual_kawase_blur'>, 'id': <'effect_000000000001'>, 'params': <{'unscaled_radius': <16>, 'brightness': <0.6>}>}>]>}}

[org.gnome.shell.extensions.blur-my-shell.appfolder]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.blur-my-shell.applications]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.blur-my-shell.lockscreen]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.blur-my-shell.overview]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.blur-my-shell.popup]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.blur-my-shell.screenshot]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.blur-my-shell.window-list]
pipeline='pipeline_default_16'

[org.gnome.shell.extensions.simple-weather]
is-activated=true
show-suntime=true
my-loc-provider='disable'

[org.gnome.shell.extensions.notifications-alert]
color='rgb(138,156,184)'

[org.gnome.shell.extensions.Bluetooth-Battery-Meter]
enable-battery-level-text=true
enable-upower-level-icon=true

[org.gnome.shell.extensions.nightthemeswitcher.time]
offset=0
manual-schedule=true

[org.gnome.shell.extensions.gnome-ui-tune]
increase-thumbnails-size='100%'
hide-search=false
always-show-thumbnails=false
overview-firefox-pip=false

[org.gnome.software]
allow-updates=false
download-updates=false
download-updates-notify=false
enable-repos-dialog=false
packaging-format-preference=['flatpak:flathub-user', 'flatpak:flathub-system']

[org.gnome.system.locale]
region='sr_RS.UTF-8@latin'

[org.gnome.mutter:GNOME]
check-alive-timeout=uint32 20000
experimental-features=['xwayland-native-scaling']

[org.gnome.login-screen]
logo='/usr/share/pixmaps/gidro-gdm-logo.png'

[org.gnome.Ptyxis]
restore-session=false

[org.gnome.settings-daemon.plugins.housekeeping]
donation-reminder-enabled=false

#-------------- RELOCATABLE SCHEMAS IN THIS SECTION ARE LOCATED IN DCONF --------------#

[org.gnome.desktop.app-folders]
folder-children=['Utilities', 'YaST', 'Pardus']
